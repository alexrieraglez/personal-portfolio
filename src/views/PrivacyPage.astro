---
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocale, getMessages } from '../i18n';

const { privacy } = getMessages(getLocale(Astro.currentLocale));
const sections = [privacy.controller, privacy.hosting, privacy.theme, privacy.external];
---

<BaseLayout title={privacy.metaTitle} description={privacy.metaDescription}>
	<main class="wrapper privacy stack gap-15">
		<Hero title={privacy.title} />
		<div class="content stack gap-8">
			{sections.map((section) => (
				<section class="stack gap-4">
					<h2>{section.title}</h2>
					<p>{section.description}</p>
				</section>
			))}
			<section class="stack gap-4">
				<h2>{privacy.rights.title}</h2>
				<p>{privacy.rights.description}</p>
				<p>{privacy.rights.contact} <a href="mailto:alejandrorieraglez@gmail.com">alejandrorieraglez@gmail.com</a>.</p>
				<p>{privacy.rights.complaint}</p>
			</section>
		</div>
	</main>
</BaseLayout>

<style>
	.privacy {
		padding-bottom: 4rem;
	}

	.content {
		width: 100%;
		max-width: 70ch;
		margin-inline: auto;
		color: var(--gray-200);
		line-height: 1.7;
		overflow-wrap: anywhere;
	}

	h2 {
		font-size: var(--text-xl);
		color: var(--gray-0);
		line-height: 1.3;
	}

	@media (min-width: 50em) {
		h2 {
			font-size: var(--text-2xl);
		}
	}
</style>
