---
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocale, getMessages } from '../i18n';

const messages = getMessages(getLocale(Astro.currentLocale));
const { about } = messages;

const experience = [
	{
		...about.experience.cybersecurityResearcher,
		tags: ['Python', 'CAPE Sandbox', 'LLM'],
	},
	{
		...about.experience.juniorSystemsEngineer,
		tags: ['AWS', 'Python', 'Data Science', 'PySpark'],
	},
	{
		...about.experience.internSIA,
		tags: ['Python', 'Docker', 'Kubernetes'],
	},
];

const education = [
	{
		...about.education.degree,
		href: 'https://www.unileon.es/estudiantes/oferta-academica/grados/grado-en-ingenieria-informatica',
	},
	{
		...about.education.master,
		href: 'https://www.unileon.es/estudiantes/oferta-academica/masteres/mu-investigacion-ciberseguridad-presencial',
	},
];

const technologies = [
	{
		title: about.skills.technologies.cloud,
		items: [
			'AWS',
			'Terraform',
			'Kubernetes',
			'Docker',
			'Linux',
			'Rancher',
		],
	},
	{
		title: about.skills.technologies.development,
		items: [
			'Python',
			'FastAPI',
			'React',
			'SQL',
			'PySpark',
			'MongoDB',
			'Apache Airflow',
		],
	},
	{
		title: about.skills.technologies.security,
		items: [
			'Cloud Security',
			'IAM',
			'Zero Trust',
			'CAPE Sandbox',
			'Git',
			'GitHub Actions',
			'CI/CD',
		],
	},
];
---

<BaseLayout title={about.metaTitle} description={about.metaDescription}>
	<div class="stack gap-20">
		<main class="wrapper about">

			<!-- CABECERA -->
			<Hero title={about.title} tagline={about.tagline} />

			<!-- PRESENTACIÓN PERSONAL -->
			<section class="intro">
				<div class="intro-content">
					<p class="eyebrow">{about.background.upperTitle}</p>

					<h2>{about.background.title}</h2>

					<p>{about.background.description1}</p>
					<p>{about.background.description2}</p>
					<p>{about.background.description3}</p>
				</div>

				<div class="intro-image">
					<img
						src="/assets/about-me.webp"
						width="480"
						height="620"
						alt={about.imageAlt}
						loading="lazy"
					/>
				</div>
			</section>

			<!-- EXPERIENCIA PROFESIONAL -->
			<section class="experience-section">
				<div class="section-heading">
					<p class="eyebrow">{about.experience.upperTitle}</p>
					<h2>{about.experience.title}</h2>
					<p>{about.experience.description}</p>
				</div>

				<ol class="timeline">
					{experience.map((job) => (
						<li class="timeline-item">
							<div class="timeline-marker" aria-hidden="true"></div>

							<article class="experience-card">
								<span class="period">{job.period}</span>
								<h3>{job.role}</h3>
								<p class="company">{job.company}</p>
								<p class="description">{job.description}</p>

								<ul class="tags">
									{job.tags.map((tag) => (
										<li class="tag">{tag}</li>
									))}
								</ul>
							</article>
						</li>
					))}
				</ol>
			</section>

			<!-- FORMACIÓN ACADÉMICA -->
			<section class="education-section">
				<div class="section-heading">
					<p class="eyebrow">{about.education.upperTitle}</p>
					<h2>{about.education.title}</h2>
				</div>

				<div class="education-grid">
					{education.map((item) => (
						<a
							class="education-card"
							href={item.href}
							target="_blank"
							rel="noopener noreferrer"
						>
							<span class="period">{item.period}</span>
							<h3>{item.title}</h3>
							<p>{item.institution}</p>
						</a>
					))}
				</div>
			</section>

			<!-- TECNOLOGÍAS Y HABILIDADES -->
			<section class="skills-section">
				<div class="section-heading">
					<p class="eyebrow">{about.skills.upperTitle}</p>
					<h2>{about.skills.title}</h2>
					<p>{about.skills.description}</p>
				</div>

				<div class="skills-grid">
					{technologies.map((group) => (
						<div class="skill-group">
							<h3>{group.title}</h3>

							<ul class="tags">
								{group.items.map((item) => (
									<li class="tag">{item}</li>
								))}
							</ul>
						</div>
					))}
				</div>
			</section>

		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 6rem;
	}

	/* GENERAL */
	section {
		color: var(--gray-200);
	}

	.eyebrow {
		font-size: var(--text-sm);
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent-regular);
		margin-bottom: 1rem;
	}

	.section-heading {
		margin-bottom: 2.5rem;
	}

	.section-heading h2 {
		font-size: var(--text-3xl);
		color: var(--gray-0);
		margin-bottom: 0.75rem;
	}

	.section-heading > p:last-child {
		max-width: 55ch;
	}

	/* PRESENTACIÓN */
	.intro {
		display: grid;
		gap: 3rem;
		align-items: center;
	}

	.intro-content h2 {
		font-size: var(--text-3xl);
		color: var(--gray-0);
		line-height: 1.15;
		margin-bottom: 1.5rem;
	}

	.intro-content > p:not(.eyebrow) {
		margin-top: 1rem;
		line-height: 1.7;
	}

	.intro-image {
		max-width: 26rem;
		width: 100%;
		margin-inline: auto;
	}

	.intro-image img {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 4;
		object-fit: cover;
		object-position: center;
		border-radius: 2rem;
		box-shadow: var(--shadow-md);
	}

	/* TIMELINE */
	.timeline {
		list-style: none;
		padding: 0;
		margin: 0;
		position: relative;
	}

	.timeline::before {
		content: '';
		position: absolute;
		left: 0.55rem;
		top: 1rem;
		bottom: 2rem;
		width: 2px;
		background: var(--gray-700);
	}

	.timeline-item {
		position: relative;
		padding-left: 3rem;
		padding-bottom: 2rem;
	}

	.timeline-item:last-child {
		padding-bottom: 0;
	}

	.timeline-marker {
		position: absolute;
		top: 1.5rem;
		left: 0.15rem;
		width: 1rem;
		height: 1rem;
		border-radius: 50%;
		background: var(--accent-regular);
		border: 3px solid var(--gray-999);
		box-shadow: 0 0 0 2px var(--accent-regular);
		z-index: 1;
	}

	.experience-card,
	.education-card,
	.skill-group {
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		padding: 1.75rem;
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
	}

	.period {
		display: block;
		color: var(--accent-regular);
		font-size: var(--text-sm);
		font-weight: 700;
		margin-bottom: 0.75rem;
	}

	.experience-card h3,
	.education-card h3 {
		font-size: var(--text-xl);
		color: var(--gray-0);
		line-height: 1.3;
	}

	.company {
		font-weight: 600;
		margin-top: 0.35rem;
	}

	.description {
		margin-top: 1rem;
		line-height: 1.65;
	}

	/* ETIQUETAS */
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0;
		margin: 1.25rem 0 0;
		list-style: none;
	}

	.tag {
		padding: 0.4rem 0.85rem;
		border-radius: 999px;
		background: var(--gray-800);
		color: var(--gray-100);
		font-size: var(--text-sm);
	}

	/* FORMACIÓN */
	.education-grid {
		display: grid;
		gap: 1.5rem;
	}

	.education-card,
	.education-card:visited,
	.education-card:hover {
		color: inherit;
		text-decoration: none;
	}

	.education-card p {
		margin-top: 0.75rem;
	}

	/* HABILIDADES */
	.skills-grid {
		display: grid;
		gap: 1.5rem;
	}

	.skill-group h3 {
		font-size: var(--text-lg);
		color: var(--gray-0);
	}

	/* ESCRITORIO */
	@media (min-width: 50em) {
		.about {
			gap: 8rem;
		}

		.intro {
			grid-template-columns: 1.2fr 0.8fr;
			gap: 4rem;
		}

		.section-heading h2,
		.intro-content h2 {
			font-size: var(--text-4xl);
		}

		.timeline {
			max-width: 55rem;
			margin-inline: auto;
		}

		.education-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.skills-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	/* ACCESIBILIDAD */
	@media (prefers-reduced-motion: no-preference) {
		.experience-card,
		.education-card,
		.skill-group {
			transition: transform 0.2s ease, box-shadow 0.2s ease;
		}

		.experience-card:hover,
		.education-card:hover,
		.skill-group:hover {
			transform: translateY(-3px);
			box-shadow: var(--shadow-md);
		}
	}
</style>
